<?xml version="1.0" encoding="utf-8"?>
<!--
    SexLab Survival FOMOD installer - PATCH over Monoman1's original SexLab Survival.

    This ships ONLY SL Survival's own changed files. Textures, meshes and sound are NOT included; they
    are inherited from Monoman1's original SexLab Survival, which MUST be installed and placed BELOW this
    mod in priority. Our loose scripts/esp override the original's.

    Layout in the packaged archive:
      SL Survival.esp                    (base - always installed, replaces the original's esp)
      scripts\, interface\, SKSE\, seq\  (base loose assets - always installed, override the original;
                                          SKSE\Plugins\SkyPatcher needs SkyPatcher, see docs)
      optional\<PatchName>\...           (one folder per optional patch; loose files)
      fomod\info.xml, fomod\ModuleConfig.xml

    TO ADD A NEW OPTIONAL PATCH:
      1. Put its loose files under  optional\<PatchName>\  (mirroring the in-game Data layout, e.g. optional\<PatchName>\scripts\foo.pex).
      2. Add a <plugin> entry to the "Optional Patches" group below, pointing <file>/<folder> source at optional\<PatchName>\... and destination at the Data-relative path.
      3. Make sure the ppj <ZipFile> still packs optional\ (it uses <Match In="optional">*</Match>).
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
    <moduleName>SexLab Survival</moduleName>

    <!-- Base - always installed. Loose files that override Monoman1's original (installed below this).
         No BSA, and no textures/meshes/sound: those come from the original SexLab Survival. -->
    <requiredInstallFiles>
        <file source="SL Survival.esp" destination="SL Survival.esp" priority="0" />
        <folder source="scripts" destination="scripts" priority="0" />
        <folder source="interface" destination="interface" priority="0" />
        <folder source="SKSE" destination="SKSE" priority="0" />
        <folder source="seq" destination="seq" priority="0" />
    </requiredInstallFiles>

    <installSteps order="Explicit">
        <installStep name="Patches">
            <optionalFileGroups order="Explicit">
                <!-- One knock-mod patch or none. Each patch masters its knock mod, so the installer
                     preselects the one whose plugin is active. -->
                <group name="Door Knocking" type="SelectExactlyOne">
                    <plugins order="Explicit">
                        <plugin name="Simply Knock">
                            <description>Beg a house owner for a bed through Simply Knock's door dialogue: a night's stay at the price of an armbinder, and with some bad luck a new owner. Installs SL Survival - Simply Knock.esp. REQUIRES Simply Knock (SimplyKnock.esp), and on Skyrim AE its SKSE64 DLL port. This is what SL Survival 0.801 and older always did.</description>
                            <files>
                                <file source="optional\SimplyKnock\SL Survival - Simply Knock.esp" destination="SL Survival - Simply Knock.esp" priority="1" />
                            </files>
                            <typeDescriptor>
                                <dependencyType>
                                    <defaultType name="Optional" />
                                    <patterns>
                                        <pattern>
                                            <dependencies operator="And">
                                                <fileDependency file="SimplyKnock.esp" state="Active" />
                                            </dependencies>
                                            <type name="Recommended" />
                                        </pattern>
                                    </patterns>
                                </dependencyType>
                            </typeDescriptor>
                        </plugin>

                        <plugin name="Simpler Knock">
                            <description>The same beg-for-a-bed scenario through Simpler Knock's door dialogue: after you pick who to talk to, beg them to let you in. Installs SL Survival - Simpler Knock.esp. REQUIRES Simpler Knock (SimplerKnock.esp, no SKSE needed); Papyrus Extender, which SL Survival already uses, finds the house's inside door (without it SLS takes the door nearest to where you come in). Do not run it together with Simply Knock: both take over door activation.</description>
                            <files>
                                <file source="optional\SimplerKnock\SL Survival - Simpler Knock.esp" destination="SL Survival - Simpler Knock.esp" priority="1" />
                            </files>
                            <typeDescriptor>
                                <dependencyType>
                                    <defaultType name="Optional" />
                                    <patterns>
                                        <pattern>
                                            <dependencies operator="And">
                                                <fileDependency file="SimplerKnock.esp" state="Active" />
                                            </dependencies>
                                            <type name="Recommended" />
                                        </pattern>
                                    </patterns>
                                </dependencyType>
                            </typeDescriptor>
                        </plugin>

                        <plugin name="None">
                            <description>No door-knock scenario. SL Survival needs neither knock mod.</description>
                            <files />
                            <typeDescriptor>
                                <dependencyType>
                                    <defaultType name="Recommended" />
                                    <patterns>
                                        <pattern>
                                            <dependencies operator="Or">
                                                <fileDependency file="SimplyKnock.esp" state="Active" />
                                                <fileDependency file="SimplerKnock.esp" state="Active" />
                                            </dependencies>
                                            <type name="Optional" />
                                        </pattern>
                                    </patterns>
                                </dependencyType>
                            </typeDescriptor>
                        </plugin>
                    </plugins>
                </group>

                <!-- One Missives build or none. Both plugins are SL Survival - Missives.esp and move the same four
                     Markarth refs; they differ only in the board's base object, which the two builds number
                     differently. The repack variant crashes the game with Nexus Missives, so Nexus is the default and
                     the repack's BSA (the Nexus release ships loose files) only changes which one is preselected. -->
                <group name="Missives Placement Fix" type="SelectExactlyOne">
                    <plugins order="Explicit">
                        <plugin name="Nexus Missives">
                            <description>Missives puts its Markarth noticeboard in the same spot by the city gate as SL Survival's toll desk, so the two clip into each other. Installs SL Survival - Missives.esp (ESL-flagged), which moves the board along the wall and a little out into the walkway, clear of the desk and a boulder. For Missives from Nexus Mods (2.03). REQUIRES Missives (Missives.esp); load it after Missives and any Missives patch that moves the Markarth board.</description>
                            <files>
                                <file source="optional\Missives\SL Survival - Missives.esp" destination="SL Survival - Missives.esp" priority="1" />
                            </files>
                            <typeDescriptor>
                                <dependencyType>
                                    <defaultType name="Optional" />
                                    <patterns>
                                        <pattern>
                                            <dependencies operator="And">
                                                <fileDependency file="Missives.esp" state="Missing" />
                                            </dependencies>
                                            <type name="NotUsable" />
                                        </pattern>
                                        <pattern>
                                            <dependencies operator="And">
                                                <fileDependency file="Missives.esp" state="Active" />
                                                <fileDependency file="Missives - Textures.bsa" state="Active" />
                                            </dependencies>
                                            <type name="Optional" />
                                        </pattern>
                                        <pattern>
                                            <dependencies operator="And">
                                                <fileDependency file="Missives.esp" state="Active" />
                                            </dependencies>
                                            <type name="Recommended" />
                                        </pattern>
                                    </patterns>
                                </dependencyType>
                            </typeDescriptor>
                        </plugin>

                        <plugin name="Missives repack (2.05 EN/RU)">
                            <description>The same board move for the merged Missives 2.05 EN/RU repack, which ships Missives.bsa and Missives - Textures.bsa and uses its own Markarth board. Pick it ONLY with that repack: with Missives from Nexus Mods the game crashes while loading. The installer preselects it when it finds Missives - Textures.bsa.</description>
                            <files>
                                <file source="optional\MissivesRepack\SL Survival - Missives.esp" destination="SL Survival - Missives.esp" priority="1" />
                            </files>
                            <typeDescriptor>
                                <dependencyType>
                                    <defaultType name="Optional" />
                                    <patterns>
                                        <pattern>
                                            <dependencies operator="And">
                                                <fileDependency file="Missives.esp" state="Missing" />
                                            </dependencies>
                                            <type name="NotUsable" />
                                        </pattern>
                                        <pattern>
                                            <dependencies operator="And">
                                                <fileDependency file="Missives.esp" state="Active" />
                                                <fileDependency file="Missives - Textures.bsa" state="Active" />
                                            </dependencies>
                                            <type name="Recommended" />
                                        </pattern>
                                    </patterns>
                                </dependencyType>
                            </typeDescriptor>
                        </plugin>

                        <plugin name="None">
                            <description>Leave Missives' Markarth noticeboard where it is. SL Survival needs no Missives patch.</description>
                            <files />
                            <typeDescriptor>
                                <dependencyType>
                                    <defaultType name="Recommended" />
                                    <patterns>
                                        <pattern>
                                            <dependencies operator="And">
                                                <fileDependency file="Missives.esp" state="Active" />
                                            </dependencies>
                                            <type name="Optional" />
                                        </pattern>
                                    </patterns>
                                </dependencyType>
                            </typeDescriptor>
                        </plugin>
                    </plugins>
                </group>

                <group name="Optional Patches" type="SelectAny">
                    <plugins order="Explicit">
                        <plugin name="Animal Friend Teammates">
                            <description>Tamed animal friends are flagged as player teammates when befriended (so they follow and fight alongside you), and the flag is cleared when they are dismissed. Installs a loose _sls_animalfriend.pex that overrides the base script. Note: the base mod leaves this off because the engine's "wait then re-follow" can be unreliable for teammates. Default: off.</description>
                            <files>
                                <file source="optional\AnimalFriendTeammate\scripts\_sls_animalfriend.pex" destination="scripts\_sls_animalfriend.pex" priority="1" />
                            </files>
                            <typeDescriptor>
                                <type name="Optional" />
                            </typeDescriptor>
                        </plugin>

                        <plugin name="SunHelm Survival Patch">
                            <description>Integrates SL Survival's needs/fatigue/sleep with SunHelm Survival: installs SL Survival Sunhelm Patch.esp, which connects the SunHelm adapter in the base scripts, plus SunHelm-keyed sleep-deprivation settings. REQUIRES SunHelm Survival (SunHelmSurvival.esp). Leave unchecked if you use iNeed, RND, Eating Sleeping Drinking or Creation Club Survival Mode instead - those are detected automatically.</description>
                            <files>
                                <folder source="optional\SunHelm\skse" destination="skse" priority="1" />
                                <file source="optional\SunHelm\SL Survival Sunhelm Patch.esp" destination="SL Survival Sunhelm Patch.esp" priority="1" />
                            </files>
                            <typeDescriptor>
                                <type name="Optional" />
                            </typeDescriptor>
                        </plugin>

                        <plugin name="Bikini Armor Break (TAWoBA)">
                            <description>Armor-break (bikini breakdown) configs and meshes for The Amazing World of Bikini Armors REMASTERED. Lets vanilla/listed armors break down into TAWoBA bikini pieces via SL Survival's bikini-break feature. REQUIRES The Amazing World of Bikini Armors REMASTERED.</description>
                            <files>
                                <folder source="optional\TewobaBikiniBreak\skse" destination="skse" priority="1" />
                                <folder source="optional\TewobaBikiniBreak\meshes" destination="meshes" priority="1" />
                            </files>
                            <typeDescriptor>
                                <type name="Optional" />
                            </typeDescriptor>
                        </plugin>

                        <plugin name="Bikini Armor Recognition (KID)">
                            <description>Tags a large curated list of third-party bikini/revealing armor mods with SL Survival's _SLS_BikiniArmor keyword (via a _KID.ini), so the Bikini Licence recognises them and the bikini curse / confiscation logic treats them as bikini. The list mirrors the OSL "Licenses" bikini curation. REQUIRES po3's Keyword Item Distributor (KID); entries for armor mods you don't have are skipped automatically. Purely a recognition list - safe to leave off if you don't run bikini armor mods.</description>
                            <files>
                                <file source="optional\BikiniArmorKID\zzz_SLS_BikiniArmor_KID.ini" destination="zzz_SLS_BikiniArmor_KID.ini" priority="1" />
                            </files>
                            <typeDescriptor>
                                <type name="Optional" />
                            </typeDescriptor>
                        </plugin>

                        <plugin name="SMP Physics Tongue Meshes">
                            <description>Replaces SL Survival's stock (static) tongue meshes with HDT-SMP rigged versions (tongue bones tong1 1-5 + tong.xml physics config), so the tongue used by the ahegao / cum-desperate features has jiggle physics. REQUIRES an HDT-SMP setup (Faster HDT-SMP). Overrides the original SexLab Survival's tongue meshes under meshes\0halofarm\tongues. Purely cosmetic - the expression features work without it. Default: off.</description>
                            <files>
                                <folder source="optional\SmpTongue\meshes" destination="meshes" priority="1" />
                            </files>
                            <typeDescriptor>
                                <type name="Optional" />
                            </typeDescriptor>
                        </plugin>

                        <plugin name="Battle Wound / Bruise Textures">
                            <description>Extra battle-wound (bruise) body overlay textures used by SL Survival's wound system.</description>
                            <files>
                                <folder source="optional\BattleWounds\textures" destination="textures" priority="1" />
                            </files>
                            <typeDescriptor>
                                <type name="Optional" />
                            </typeDescriptor>
                        </plugin>

                        <plugin name="SlaveTats Pack">
                            <description>SL Survival's own overlays (wounds and bruises, spank marks, magic-silence collar, bikini curse, cum desperation) as a SlaveTats pack, with UBE variants (used by SlaveTats NG's UBE build) and three hand-print spank marks (from slavetats_spanked) for "Survival Ass Slapping". With it SL Survival applies its overlays through SlaveTats instead of its own NiOverride slots. Pack by RustyOldSword. REQUIRES SlaveTats NG (SlaveTats.esp + the SlaveTatsNG SKSE plugin); without them the base scripts keep using their own overlays.</description>
                            <files>
                                <folder source="optional\SlaveTatsPack\textures" destination="textures" priority="1" />
                            </files>
                            <typeDescriptor>
                                <type name="Optional" />
                            </typeDescriptor>
                        </plugin>

                        <plugin name="UBE Overlay Textures">
                            <description>UBE-layout copies of SL Survival's overlays for characters of a UBE 2.0 race: the wounds and bruises, the cum-desperation marks, the bikini curse and the magic-silence collar. SL Survival picks them per actor; everyone else keeps the standard textures. Only useful with UBE 2.0 installed. With the SlaveTats Pack, SlaveTats NG's UBE build uses that pack's own UBE copies instead.</description>
                            <files>
                                <folder source="optional\BattleWoundsUBE\textures" destination="textures" priority="1" />
                            </files>
                            <typeDescriptor>
                                <type name="Optional" />
                            </typeDescriptor>
                        </plugin>
                    </plugins>
                </group>
            </optionalFileGroups>
        </installStep>
    </installSteps>
</config>
